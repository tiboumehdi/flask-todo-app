#!/bin/bash
# Script de sauvegarde pour Flask Todo App
# Template: templates/backup.sh.j2

set -e

# Configuration
APP_NAME="{{ app_name }}"
TIMESTAMP=$(date +%Y%m%d%H%M%S)
BACKUP_DIR="{{ backup_path }}"
DATA_DIR="{{ data_path }}/data"
LOG_FILE="{{ log_path }}/backup.log"
RETENTION_DAYS="{{ backup_retention_days }}"
USER="{{ app_user }}"

# Création du dossier de sauvegarde s'il n'existe pas
mkdir -p $BACKUP_DIR

# Log de début de sauvegarde
echo "[$(date)] Starting backup for $APP_NAME" >> $LOG_FILE

# Création de l'archive
BACKUP_FILE="$BACKUP_DIR/${APP_NAME}-backup-$TIMESTAMP.tar.gz"
tar -czf $BACKUP_FILE -C $(dirname $DATA_DIR) $(basename $DATA_DIR)
chown $USER:$USER $BACKUP_FILE
chmod 640 $BACKUP_FILE

# Log de fin de sauvegarde
echo "[$(date)] Backup completed: $BACKUP_FILE (Size: $(du -h $BACKUP_FILE | cut -f1))" >> $LOG_FILE

# Suppression des anciennes sauvegardes
echo "[$(date)] Cleaning up old backups (older than $RETENTION_DAYS days)..." >> $LOG_FILE
find $BACKUP_DIR -name "${APP_NAME}-backup-*.tar.gz" -type f -mtime +$RETENTION_DAYS -delete -print >> $LOG_FILE 2>&1

# Récapitulatif
TOTAL_BACKUPS=$(find $BACKUP_DIR -name "${APP_NAME}-backup-*.tar.gz" | wc -l)
TOTAL_SIZE=$(du -sh $BACKUP_DIR | cut -f1)
echo "[$(date)] Backup summary: $TOTAL_BACKUPS backups, total size: $TOTAL_SIZE" >> $LOG_FILE

exit 0